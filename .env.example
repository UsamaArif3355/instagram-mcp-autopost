# Copy to .env for LOCAL use only. Never commit .env.
# In GitHub Actions these live in Settings > Secrets and variables > Actions.

# Long-lived token (Page token or user token) with instagram_basic and instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business/Creator account ID (from /{page-id}?fields=instagram_business_account)
INSTAGRAM_ACCOUNT_ID=

# Only needed by the token expiry check
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional
INSTAGRAM_API_VERSION=v25.0
MAX_POSTS_PER_RUN=1
TOKEN_WARN_DAYS=10
